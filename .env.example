# Database connection string
# For local development with SQLite:
DATABASE_URL="file:./dev.db"

# For production deployment with PostgreSQL (e.g. Supabase, Neon, Railway, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/votebd?sslmode=require"

# Base application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional session secret
SESSION_SECRET="votebd-secure-secret-key-at-least-32-chars-long"
